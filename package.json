{
  "name": "gozluk-yonetim-sistemi",
  "version": "1.0.0",
  "description": "Profesyonel Gözlük Satış ve Stok Yönetim Sistemi",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "api": "node server/serve.cjs",
    "api:dev": "node server/serve.cjs --port=4000 --no-open",
    "serve": "node server/serve.cjs",
    "pack": "vite build && pkg . --output release/OptikPro.exe",
    "deploy": "vite build && echo 'Build completed. Ready for deployment.'"
  },
  "bin": "server/serve.cjs",
  "pkg": {
    "assets": [
      "dist/**/*"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "release"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/[kullanici-adi]/gozluk-yonetim-sistemi.git"
  },
  "keywords": [
    "gozluk",
    "optik",
    "yonetim",
    "stok",
    "satis"
  ],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "date-fns": "^3.3.1",
    "dexie": "^3.2.4",
    "dexie-react-hooks": "^1.1.7",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.344.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "recharts": "^2.12.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "pkg": "^5.8.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.0"
  }
}
